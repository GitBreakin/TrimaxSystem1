# Copy this file to trimax.properties and fill in the values. Never commit real database credentials.
# TRIMAX reads the first trimax.properties it finds:
#   1. the folder TRIMAX was started from (the project folder when run from the IDE),
#   2. the folder of the TRIMAX .exe or .jar (next to the app),
#   3. %USERPROFILE%\.trimax\trimax.properties  (works however TRIMAX is started; best for an installed .exe).
# Environment variables TRIMAX_DB_URL, TRIMAX_DB_USER, and TRIMAX_DB_PASSWORD take precedence.

db.url=jdbc:postgresql://YOUR_HOST:5432/YOUR_DATABASE?sslmode=require
db.user=YOUR_DATABASE_USER
db.password=YOUR_DATABASE_PASSWORD

# Optional. Project URL used to show private photos (Attendance, delivery proofs) through the
# trimax-admin-media Edge Function. Not a secret. If left out, it is worked out from db.user
# ("postgres.<project ref>"). No storage or service key is ever needed on this PC.
# supabase.url=https://YOUR_PROJECT_REF.supabase.co

# Email for employee password-setup codes and password resets (see SMTP_EMAIL_SETUP.md).
# Gmail: smtp.password is a 16-letter App Password, not the normal password. Restart TRIMAX after changes.
# smtp.host=smtp.gmail.com
# smtp.user=YOUR_TRIMAX_GMAIL@gmail.com
# smtp.password=YOUR_16_LETTER_APP_PASSWORD
# Optional: smtp.port=587 (or 465 for SSL), smtp.from=sender address (defaults to smtp.user)
